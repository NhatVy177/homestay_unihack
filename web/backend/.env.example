PORT=5000
DB_SERVER=tcp:localhost,1433
DB_NAME=HOMEDORM4
DB_TRUSTED_CONNECTION=true
# Or use SQL Server authentication:
# DB_USER=sa
# DB_PASS=123456
AUTH_SECRET=happyroom-secret-2026
CLIENT_URL=http://localhost:5173
AVALANCHE_ENABLED=false
AVALANCHE_CHAIN_ID=43113
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_CONTRACT_ADDRESS=
AVALANCHE_APP_ORIGIN=http://localhost:5173
AVALANCHE_MAX_GAS=600000
# Test wallets only. Operator keys stay on this server; never use VITE_*.
AVALANCHE_MANAGER_PRIVATE_KEY=
AVALANCHE_ACCOUNTANT_PRIVATE_KEY=
AVALANCHE_RELAYER_PRIVATE_KEY=

# D-011: Privy JWT-based auth (ví nhúng dùng chính phiên đăng nhập HomeStayDorm).
# Tạo khóa: npm run privy:keygen  → dán public key in ra vào Privy Dashboard.
PRIVY_APP_ID=
# email (mặc định, D-015: mã OTP email, gói Privy miễn phí) hoặc jwt (D-011, cần gói Privy Scale).
PRIVY_AUTH_MODE=email
PRIVY_JWT_PRIVATE_KEY_FILE=
# D-012/Q-08: email thông báo. Không đặt SMTP_HOST → chỉ in email ra console (dev-log).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HomeStayDorm <no-reply@homestaydorm.local>
# Demo: chuyển mọi email tới một hộp thư thử, không gửi tới email trong dữ liệu mẫu.
MAIL_REDIRECT_TO=
# D-023: chu kỳ quét yêu cầu chờ duyệt (nhắc quản lý 8h, từ chối 12h) và phiếu chờ thanh toán.
DAT_COC_YEU_CAU_INTERVAL_MS=300000
DAT_COC_HET_HAN_INTERVAL_MS=300000
# D-013: cổng ví điện tử MÔ PHỎNG (không nhận tiền thật). Đặt chuỗi ngẫu nhiên >= 16 ký tự.
PAYMENT_SIM_ENABLED=true
PAYMENT_SIM_SECRET=

# Khi chay backend preview rieng: tat jobs de khong quet lap cung backend dang dung.
# Mac dinh van bat nhu truoc. Chi preview local moi dat false.
SCHEDULERS_ENABLED=true
