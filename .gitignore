!web/backend/uploads/chung-tu/.gitkeep
web/backend/uploads/chung-tu-doi-soat/*
!web/backend/uploads/chung-tu-doi-soat/.gitkeep


# Local UI review screenshots and reports
web/frontend/.ui-screens/

web/backend/uploads/avatars/*
