# Environment files (NEVER commit secrets)
.env
.env.*
!.env.example
*.env
*.local

# Dependencies
node_modules/
package-lock.json.bak

# Production build outputs
dist/
build/
out/
demo-screenshots/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
error_log.txt

# OS & Editor generated files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.user

